---
import { Icon } from 'astro-icon/components';
import Photo from '../components/Photo.astro';
import Ornament from '../components/Ornament.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { PHONE, TEL, TIKTOK, LOCATION, OCCASIONS } from '../data/site.js';
import '../styles/global.css';

const pillars = [
  { icon: 'ph:armchair-light', title: 'Rent', text: 'Tables, chairs, tablecloths and a classic popcorn machine.' },
  { icon: 'ph:flower-tulip-light', title: 'Decorate', text: 'Tablecloths in various colors and simple decor to set the mood.' },
  { icon: 'ph:sparkle-light', title: 'Celebrate', text: 'We deliver and set up. You enjoy the moment.' },
];

const inventory = [
  { img: 'item-chair', title: 'Chairs', text: 'White folding chairs', w: 'w-28 sm:w-32' },
  { img: 'item-table', title: '6 ft rectangular tables', text: 'Standard banquet size', w: 'w-44 sm:w-60' },
  { img: 'item-linens', title: 'Tablecloths', text: 'Various colors', w: 'w-36 sm:w-44' },
  { img: 'item-popcorn', title: 'Popcorn machine', text: 'Classic cart, as pictured', w: 'w-24 sm:w-28' },
  { img: 'item-decor', title: 'Simple decor', text: 'Floral centerpieces & accents', w: 'w-32 sm:w-36' },
] as const;

const rows = ['Guests', '6 ft tables', 'Chairs', 'Tablecloths', 'Simple decor', 'Popcorn machine'];

const packages = [
  { name: 'Basic', img: 'pkg-basic', price: 99, values: ['Up to 30', '4', '30', true, false, false] },
  { name: 'Celebration', img: 'pkg-celebration', price: 149, values: ['Up to 50', '6', '50', true, true, true], featured: true },
  { name: 'Complete', img: 'pkg-complete', price: 229, values: ['Up to 80', '10', '80', true, true, true] },
] as const;

// Las fotos del hero van con object-cover, así que su ancho pintado depende del alto:
// la apaisada (≈1.97:1) mide 1.97x el alto en pantallas más altas que ella; la vertical
// de móvil (≈0.83:1) mide 0.83x el alto de su capa, que es un 124 % de la pantalla.
const HERO_SIZES = '(max-aspect-ratio: 197/100) 197vh, 100vw';
const HERO_SIZES_MOBILE = '103vh';

const steps = [
  { title: 'Get a quote', text: `Call ${PHONE} with your date, location and guest count.` },
  { title: 'Choose your package', text: 'Basic, Celebration or Complete, based on your guest list.' },
  { title: 'We deliver & set up', text: 'We bring everything to your event and set it up for you.' },
  { title: 'Celebrate', text: 'Enjoy the moment with your people.' },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Eventti Rentals &amp; Decor — Party rentals in Newport Beach, CA</title>
    <meta
      name="description"
      content="Tables, chairs, tablecloths, decor and a popcorn machine for birthdays, quinceañeras and family gatherings in Orange County. We deliver and set up. Packages from $99."
    />
    <meta name="theme-color" content="#17110b" />
    <link rel="icon" href="/img/favicon.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,500&family=Jost:wght@300;400;500&family=Pinyon+Script&display=swap"
      rel="stylesheet"
    />
    <link
      rel="preload"
      as="image"
      type="image/avif"
      media="(min-width: 1024px)"
      imagesrcset="/img/hero-garden-960.avif 960w, /img/hero-garden-1600.avif 1600w, /img/hero-garden-2400.avif 2400w, /img/hero-garden-2800.avif 2800w"
      imagesizes={HERO_SIZES}
    />
    <link
      rel="preload"
      as="image"
      type="image/avif"
      media="(max-width: 1023px)"
      imagesrcset="/img/about-table-560.avif 560w, /img/about-table-900.avif 900w, /img/about-table-1300.avif 1300w, /img/about-table-1800.avif 1800w"
      imagesizes={HERO_SIZES_MOBILE}
    />

    <meta property="og:title" content="Eventti Rentals & Decor" />
    <meta property="og:description" content="Your event, our passion. Party rentals and setup in Orange County, CA." />
    <meta property="og:image" content="/img/hero-garden-1600.jpg" />
    <meta property="og:type" content="website" />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'LocalBusiness',
        name: 'Eventti Rentals & Decor',
        description: 'Event rental and decor company: tables, chairs, tablecloths, decor and popcorn machine.',
        telephone: TEL,
        areaServed: 'Orange County, CA',
        address: { '@type': 'PostalAddress', addressLocality: 'Newport Beach', addressRegion: 'CA', addressCountry: 'US' },
        priceRange: '$99–$229',
      })}
    />

    <noscript>
      <style>
        .will-reveal {
          opacity: 1 !important;
        }
      </style>
    </noscript>
  </head>

  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[60] focus:rounded-full focus:bg-gold focus:px-5 focus:py-2 focus:text-sm focus:text-dusk"
    >
      Skip to content
    </a>

    <Header />

    <main id="main">
      <!-- ═══ Hero ═══════════════════════════════════════════════════════ -->
      <section id="top" class="hero grain relative isolate flex min-h-[100svh] flex-col overflow-hidden bg-dusk">
        <!-- En móvil: la versión vertical de la misma escena, y una capa más alta que la pantalla
             para que la lente quede encima del texto y caiga sobre el ramo enfocado. -->
        <div id="hero-media" class="absolute inset-x-0 top-0 -z-10 h-full max-lg:top-[-24%] max-lg:h-[124%]">
          <Photo
            name="hero-garden"
            mobile="about-table"
            alt=""
            sizes={HERO_SIZES}
            mobileSizes={HERO_SIZES_MOBILE}
            priority
            class="hero-dim absolute inset-0 size-full object-cover"
          />
          <Photo
            name="hero-garden"
            mobile="about-table"
            alt="Backyard banquet tables with white linens, burlap runners and floral centerpieces under string lights"
            sizes={HERO_SIZES}
            mobileSizes={HERO_SIZES_MOBILE}
            priority
            class="hero-lens absolute inset-0 size-full object-cover"
          />
          <svg id="hero-ring" class="hero-ring -rotate-90" viewBox="0 0 216 216" aria-hidden="true">
            <circle cx="108" cy="108" r="100" fill="none" stroke="#ecd598" stroke-width="1.6" />
            <circle cx="108" cy="108" r="106.5" fill="none" stroke="#c9a227" stroke-width="0.6" />
          </svg>
        </div>

        <!-- Velos: lectura del texto a la izquierda y fundido hacia la sección siguiente -->
        <div
          class="absolute inset-0 -z-10 bg-[linear-gradient(90deg,rgb(23_17_11/0.85)_0%,rgb(23_17_11/0.5)_34%,transparent_54%)] max-lg:hidden"
        ></div>
        <div
          class="absolute inset-x-0 bottom-0 -z-10 h-[62%] bg-gradient-to-t from-dusk via-dusk/75 to-transparent lg:h-48 lg:via-dusk/40"
        ></div>

        <div id="hero-content" class="mx-auto flex w-full max-w-7xl flex-1 items-end px-5 pt-28 pb-14 lg:items-center lg:px-10 lg:pb-20">
          <div class="max-w-xl">
            <h1>
              <span id="hero-line1" class="display-caps block overflow-clip pb-2 text-[clamp(2.1rem,5.4vw,4.25rem)] text-linen">
                YOUR EVENT
              </span>
              <span
                id="hero-script"
                class="gold-gradient -mt-1 block pb-4 font-script text-[clamp(3.6rem,10vw,7.75rem)] leading-[0.82]"
              >
                Our Passion
              </span>
            </h1>

            <div id="hero-copy">
              <p class="max-w-md text-lg leading-relaxed text-linen/80">
                Tables, chairs, machines, decor and more, delivered and set up at your event.
              </p>
              <p class="mt-2 font-display text-2xl text-gold-light italic">Rent. Decorate. Celebrate.</p>

              <div class="mt-9 flex flex-wrap items-center gap-x-7 gap-y-4">
                <a
                  href={`tel:${TEL}`}
                  class="animated pulse infinite slower inline-flex items-center gap-2.5 rounded-full bg-gold px-8 py-4 text-xs tracking-[0.18em] text-dusk hover:bg-gold-light"
                >
                  <Icon name="ph:phone-light" class="size-4" />
                  <span class="lining">Call {PHONE}</span>
                </a>
                <a
                  href="#packages"
                  class="border-b border-linen/30 pb-1 text-xs tracking-[0.18em] text-linen/80 hover:border-gold-light hover:text-gold-light"
                >
                  See packages
                </a>
              </div>
            </div>
          </div>
        </div>

        <div id="hero-facts" class="will-reveal border-t border-gold/20 bg-dusk/45 backdrop-blur-md max-lg:hidden">
          <ul class="mx-auto grid max-w-7xl grid-cols-3 divide-x divide-gold/15 px-10 py-5 text-sm text-linen/75">
            <li class="flex items-center justify-center gap-3">
              <Icon name="ph:truck-light" class="size-5 text-gold" />We deliver &amp; set up
            </li>
            <li class="flex items-center justify-center gap-3">
              <Icon name="ph:tag-light" class="size-5 text-gold" /><span class="lining">Packages from $99</span>
            </li>
            <li class="flex items-center justify-center gap-3">
              <Icon name="ph:map-pin-light" class="size-5 text-gold" />Newport Beach, Orange County
            </li>
          </ul>
        </div>
      </section>

      <!-- ═══ About ══════════════════════════════════════════════════════ -->
      <section id="about" class="grain relative bg-linen py-28 lg:py-40">
        <div class="mx-auto grid max-w-7xl items-center gap-20 px-5 lg:grid-cols-[1fr_1.05fr] lg:gap-24 lg:px-10">
          <div id="about-media" class="relative mx-auto w-full max-w-md lg:max-w-lg">
            <div class="rounded-t-full border border-gold/45 p-2.5">
              <div class="aspect-[4/5] overflow-hidden rounded-t-full">
                <Photo
                  name="about-table"
                  alt="Banquet table with a burlap runner and mason jar centerpieces, string lights overhead"
                  sizes="(min-width: 1024px) 34rem, 90vw"
                  class="size-full scale-[1.08] object-cover"
                />
              </div>
            </div>

            <div
              id="about-detail"
              class="absolute -right-3 -bottom-12 size-40 rounded-full border border-gold/55 bg-linen p-2 sm:size-52 lg:-right-14"
            >
              <div class="size-full overflow-hidden rounded-full">
                <Photo
                  name="about-detail"
                  alt="Candles and greenery along a table set with rattan chargers"
                  sizes="13rem"
                  class="size-full object-cover"
                />
              </div>
            </div>

            <svg class="absolute top-10 -left-4 size-7 text-gold sm:-left-8" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 0c1 7 5 11 12 12-7 1-11 5-12 12-1-7-5-11-12-12 7-1 11-5 12-12Z" fill="currentColor" />
            </svg>
          </div>

          <div id="about-copy">
            <Ornament class="text-gold" />
            <h2 class="display mt-8 text-[clamp(2.9rem,6.4vw,5.25rem)] text-ink">
              Good people.<br /><em class="italic-accent">Great events.</em>
            </h2>
            <p class="mt-8 max-w-[34rem] text-lg leading-relaxed text-ink/75">
              Eventti is an event rental and decor company based in Newport Beach, Orange County. We bring the tables,
              chairs, tablecloths, decor and popcorn machine. Then we deliver and set it all up, so you can focus on your
              guests.
            </p>

            <dl class="mt-14 grid gap-10 border-t border-gold/30 pt-10 sm:grid-cols-3 sm:gap-8">
              {
                pillars.map((p) => (
                  <div>
                    <dt class="flex items-center gap-3 font-display text-[1.65rem] text-gold-text italic">
                      <Icon name={p.icon} class="size-6 shrink-0 not-italic" />
                      {p.title}
                    </dt>
                    <dd class="mt-3 text-sm leading-relaxed text-ink/70">{p.text}</dd>
                  </div>
                ))
              }
            </dl>
          </div>
        </div>
      </section>

      <!-- ═══ Occasions ══════════════════════════════════════════════════ -->
      <section id="occasions" class="grain dusk-glow relative overflow-hidden pt-28 pb-24 lg:pt-36 lg:pb-44">
        <svg
          class="pointer-events-none absolute -top-56 -right-48 size-[44rem] text-gold/15"
          viewBox="0 0 200 200"
          aria-hidden="true"
        >
          <circle cx="100" cy="100" r="98" fill="none" stroke="currentColor" stroke-width="0.35" />
          <circle cx="100" cy="100" r="88" fill="none" stroke="currentColor" stroke-width="0.35" />
        </svg>

        <div class="relative mx-auto max-w-7xl px-5 lg:px-10">
          <div id="occ-head" class="max-w-3xl">
            <Ornament class="text-gold" />
            <h2 class="display mt-8 text-[clamp(2.6rem,6vw,4.75rem)] text-linen">
              Made for every
              <span class="gold-gradient font-script text-[1.32em] leading-[0.8]">celebration</span>
            </h2>
            <p class="mt-6 max-w-xl text-lg leading-relaxed text-linen/65">
              From a backyard birthday to a quinceañera, we set the table for your people.
            </p>
          </div>

          <ul
            class="-mx-5 mt-20 flex snap-x snap-mandatory gap-5 overflow-x-auto px-5 pb-8 [scrollbar-width:none] lg:mx-0 lg:grid lg:grid-cols-5 lg:gap-6 lg:overflow-visible lg:px-0 lg:pb-0"
          >
            {
              OCCASIONS.map((o) => (
                <li class="occasion group w-[68vw] shrink-0 snap-center sm:w-[40vw] lg:w-auto lg:even:mt-16">
                  <div class="relative">
                    <div class="rounded-t-full border border-gold/35 p-1.5 transition-colors duration-700 group-hover:border-gold/80">
                      <div class="aspect-[3/4] overflow-hidden rounded-t-full">
                        <Photo
                          name={o.img}
                          alt={o.alt}
                          sizes="(min-width: 1024px) 15rem, 68vw"
                          class="size-full object-cover brightness-[0.88] transition duration-[1400ms] ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-[1.06] group-hover:brightness-100"
                        />
                      </div>
                    </div>
                    <span class="badge absolute -bottom-7 left-1/2 grid size-14 -translate-x-1/2 place-items-center rounded-full border border-gold/70 bg-dusk text-gold-light shadow-[0_0_0_6px_var(--color-dusk)] transition-shadow duration-700 group-hover:shadow-[0_0_0_6px_var(--color-dusk),0_0_28px_rgb(255_207_122/0.35)]">
                      {o.icon ? (
                        <Icon name={`${o.icon}-light`} class="size-6" />
                      ) : (
                        <span class="lining font-display text-2xl">{o.label}</span>
                      )}
                    </span>
                  </div>
                  <h3 class="mt-12 text-center font-display text-[1.65rem] text-linen">{o.title}</h3>
                  <p class="mx-auto mt-2 max-w-[22ch] text-center text-sm leading-relaxed text-linen/60">{o.text}</p>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <!-- ═══ Rentals ════════════════════════════════════════════════════ -->
      <section id="rentals" class="grain relative bg-linen py-28 lg:py-40">
        <div class="mx-auto max-w-7xl px-5 lg:px-10">
          <div class="grid gap-8 lg:grid-cols-[1.3fr_1fr] lg:items-end">
            <div>
              <Ornament class="text-gold" />
              <h2 class="display mt-8 text-[clamp(2.6rem,6vw,4.75rem)] text-ink">
                Everything you need to <em class="italic-accent">set the scene</em>
              </h2>
            </div>
            <p class="max-w-md text-lg leading-relaxed text-ink/65 lg:justify-self-end">
              The pieces behind every Eventti setup, delivered and set up at your event.
            </p>
          </div>

          <ul class="mt-24 grid grid-cols-2 gap-x-6 gap-y-16 sm:grid-cols-3 lg:grid-cols-5 lg:gap-x-0">
            {
              inventory.map((item) => (
                <li class="item group text-center">
                  <div class="relative flex h-48 items-end justify-center sm:h-60">
                    <span class="absolute bottom-0 h-3 w-3/5 rounded-[50%] bg-ink/20 blur-md transition-all duration-700 group-hover:w-2/5 group-hover:bg-ink/12" />
                    <Photo
                      name={item.img}
                      alt={item.title}
                      sizes="(min-width: 640px) 13rem, 45vw"
                      class={`relative max-h-full ${item.w} object-contain transition-transform duration-700 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:-translate-y-2`}
                    />
                  </div>
                  <div class="rule mt-7 h-px origin-left bg-gradient-to-r from-gold/20 via-gold/60 to-gold/20" />
                  <h3 class="mt-6 font-display text-[1.4rem] text-ink">{item.title}</h3>
                  <p class="mt-1.5 text-sm text-ink/60">{item.text}</p>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <!-- ═══ Popcorn ════════════════════════════════════════════════════ -->
      <section class="grain dusk-glow relative overflow-hidden py-28 lg:py-40">
        <div class="mx-auto grid max-w-7xl items-center gap-20 px-5 lg:grid-cols-2 lg:gap-24 lg:px-10">
          <div class="order-2 lg:order-1">
            <h2 id="popcorn-script" class="gold-gradient pb-4 font-script text-[clamp(3.4rem,8.5vw,6.5rem)] leading-[0.9]">
              Making events sweeter
            </h2>
            <div id="popcorn-copy" class="will-reveal">
              <p class="mt-8 max-w-md text-lg leading-relaxed text-linen/75">
                A classic popcorn cart that brings fresh popcorn and a little movie-night fun to any party. It works as a
                snack station and a centerpiece in one.
              </p>
              <p class="mt-10 inline-flex flex-wrap items-center gap-x-2 gap-y-1 rounded-full border border-gold/45 px-6 py-3.5 text-sm text-linen/75">
                <Icon name="ph:check-light" class="size-4 shrink-0 text-gold" />
                Included in the <em class="font-display text-lg text-linen italic">Celebration</em> and
                <em class="font-display text-lg text-linen italic">Complete</em> packages
              </p>
            </div>
          </div>

          <div id="popcorn-media" class="relative order-1 mx-auto w-full max-w-sm lg:order-2 lg:max-w-md">
            <!-- La luz de la máquina -->
            <div
              class="absolute -inset-16 bg-[radial-gradient(closest-side,rgb(255_207_122/0.24),transparent)] blur-2xl"
              aria-hidden="true"
            ></div>
            <div class="relative rounded-t-full border border-gold/50 p-2.5">
              <div class="aspect-[3/4] overflow-hidden rounded-t-full">
                <Photo
                  name="popcorn-cart"
                  alt="Vintage popcorn cart serving fresh popcorn at an outdoor party"
                  sizes="(min-width: 1024px) 28rem, 90vw"
                  class="size-full scale-[1.08] object-cover"
                />
              </div>
            </div>
            <svg class="absolute -top-2 -right-6 size-9 text-gold-light" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 0c1 7 5 11 12 12-7 1-11 5-12 12-1-7-5-11-12-12 7-1 11-5 12-12Z" fill="currentColor" />
            </svg>
          </div>
        </div>
      </section>

      <!-- ═══ Packages ═══════════════════════════════════════════════════ -->
      <section id="packages" class="grain relative bg-linen py-28 lg:py-40">
        <div class="mx-auto max-w-7xl px-5 lg:px-10">
          <div class="flex flex-wrap items-end justify-between gap-6">
            <div>
              <Ornament class="text-gold" />
              <h2 class="display mt-8 text-[clamp(2.6rem,6vw,4.75rem)] text-ink">
                Choose your <em class="italic-accent">package</em>
              </h2>
            </div>
            <p class="text-sm text-ink/70">Starting prices. Delivery and setup fees may apply.</p>
          </div>

          <!-- Escritorio: comparativa con subgrid para que las filas casen con las etiquetas -->
          <div class="mt-16 hidden grid-cols-[12rem_repeat(3,1fr)] grid-rows-[repeat(10,auto)] gap-x-6 lg:grid">
            <div class="col-start-1 row-span-full grid grid-rows-subgrid text-ink/75">
              <span aria-hidden="true"></span>
              <span aria-hidden="true"></span>
              {rows.map((r) => <p class="flex items-center border-b border-ink/12 py-4">{r}</p>)}
              <p class="flex items-center pt-6">Starting at</p>
              <span aria-hidden="true"></span>
            </div>

            {
              packages.map((p) => {
                const dark = 'featured' in p && p.featured;
                return (
                  <div
                    class:list={[
                      'pkg row-span-full grid grid-rows-subgrid overflow-hidden rounded-t-[2.5rem] rounded-b-2xl border',
                      dark ? 'border-gold/60 bg-dusk text-linen shadow-[0_30px_60px_-25px_rgb(23_17_11/0.55)]' : 'border-gold/30 bg-white text-ink',
                    ]}
                  >
                    <h3
                      class:list={[
                        'px-2 py-5 text-center font-display text-2xl italic',
                        dark ? 'text-gold-light' : 'bg-dusk text-linen',
                      ]}
                    >
                      {p.name}
                    </h3>
                    <Photo name={p.img} alt={`${p.name} package setup`} sizes="22rem" class="h-44 w-full object-cover" />
                    {p.values.map((v) => (
                      <div class:list={['mx-5 flex items-center justify-center border-b py-4', dark ? 'border-linen/10' : 'border-ink/10']}>
                        {typeof v === 'boolean' ? (
                          v ? (
                            <span class:list={['grid size-7 place-items-center rounded-full', dark ? 'bg-gold/20 text-gold-light' : 'bg-gold/20 text-gold-text']}>
                              <Icon name="ph:check-bold" class="size-3.5" />
                              <span class="sr-only">Included</span>
                            </span>
                          ) : (
                            <span class="opacity-30">
                              —<span class="sr-only">Not included</span>
                            </span>
                          )
                        ) : (
                          <span class="lining opacity-90">{v}</span>
                        )}
                      </div>
                    ))}
                    <p class="relative grid place-items-center py-6">
                      <span class:list={['brush absolute top-1/2 h-12 w-[62%] -translate-y-1/2 origin-left', dark ? 'bg-gold/80' : 'bg-gold/55']} />
                      <span class="lining relative font-display text-5xl font-medium text-ink">
                        <span class="align-super text-2xl">$</span><span class="price" data-to={p.price}>{p.price}</span>
                      </span>
                    </p>
                    <a
                      href={`tel:${TEL}`}
                      class:list={[
                        'mx-5 mb-6 rounded-full py-3 text-center text-xs tracking-[0.16em]',
                        dark ? 'bg-gold text-dusk hover:bg-gold-light' : 'border border-ink/25 hover:border-gold hover:bg-gold hover:text-dusk',
                      ]}
                    >
                      Call to book {p.name}
                    </a>
                  </div>
                );
              })
            }
          </div>

          <!-- Móvil y tablet -->
          <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:hidden">
            {
              packages.map((p) => {
                const dark = 'featured' in p && p.featured;
                return (
                  <div
                    class:list={[
                      'pkg overflow-hidden rounded-t-[2.5rem] rounded-b-2xl border',
                      dark ? 'border-gold/60 bg-dusk text-linen' : 'border-gold/30 bg-white text-ink',
                    ]}
                  >
                    <h3 class:list={['py-4 text-center font-display text-2xl italic', dark ? 'text-gold-light' : 'bg-dusk text-linen']}>
                      {p.name}
                    </h3>
                    <Photo name={p.img} alt={`${p.name} package setup`} sizes="(min-width: 640px) 45vw, 90vw" class="h-40 w-full object-cover" />
                    <ul class:list={['divide-y px-5', dark ? 'divide-linen/10' : 'divide-ink/10']}>
                      {rows.map((r, i) => (
                        <li class="flex items-center justify-between gap-4 py-3 text-sm">
                          <span class="opacity-70">{r}</span>
                          {typeof p.values[i] === 'boolean' ? (
                            p.values[i] ? (
                              <Icon name="ph:check-bold" class={`size-4 ${dark ? 'text-gold-light' : 'text-gold-text'}`} />
                            ) : (
                              <span class="opacity-30">—</span>
                            )
                          ) : (
                            <span class="lining">{p.values[i]}</span>
                          )}
                        </li>
                      ))}
                    </ul>
                    <p class="relative grid place-items-center py-6">
                      <span class:list={['brush absolute top-1/2 h-12 w-40 -translate-y-1/2', dark ? 'bg-gold/80' : 'bg-gold/55']} />
                      <span class="lining relative font-display text-5xl font-medium text-ink">
                        <span class="align-super text-2xl">$</span>{p.price}
                      </span>
                    </p>
                    <a
                      href={`tel:${TEL}`}
                      class:list={[
                        'mx-5 mb-6 block rounded-full py-3 text-center text-xs tracking-[0.16em]',
                        dark ? 'bg-gold text-dusk' : 'border border-ink/25',
                      ]}
                    >
                      Call to book {p.name}
                    </a>
                  </div>
                );
              })
            }
          </div>
        </div>
      </section>

      <!-- ═══ Process ════════════════════════════════════════════════════ -->
      <section id="process" class="grain relative bg-burlap py-28 lg:py-40">
        <div class="mx-auto max-w-7xl px-5 lg:px-10">
          <div class="text-center">
            <Ornament align="center" class="text-gold-deep" />
            <h2 class="display mt-8 text-[clamp(2.6rem,6vw,4.75rem)] text-ink">
              We deliver <em class="italic-accent">&amp; set up</em>
            </h2>
            <p class="mt-6 text-lg leading-relaxed text-ink/65">Booking takes one call. Here's how it works.</p>
          </div>

          <ol class="relative mt-24 grid gap-y-14 sm:grid-cols-2 lg:grid-cols-4">
            <span
              id="process-track"
              class="absolute top-9 right-[12.5%] left-[12.5%] hidden h-px origin-left bg-gradient-to-r from-gold-deep via-gold to-gold-deep lg:block"
              aria-hidden="true"
            ></span>

            {
              steps.map((s, i) => (
                <li class="step relative text-center">
                  <span class="dot lining relative z-10 mx-auto grid size-[4.5rem] place-items-center rounded-full border border-gold bg-dusk font-display text-3xl text-gold-light shadow-[0_0_0_8px_var(--color-burlap)]">
                    {i + 1}
                  </span>
                  <h3 class="mt-7 font-display text-[1.65rem] text-ink">{s.title}</h3>
                  <p class="mx-auto mt-2.5 max-w-[26ch] text-sm leading-relaxed text-ink/70">
                    {i === 0 ? (
                      <>
                        Call{' '}
                        <a href={`tel:${TEL}`} class="lining border-b border-ink/40 text-ink hover:border-gold-deep">
                          {PHONE}
                        </a>{' '}
                        with your date, location and guest count.
                      </>
                    ) : (
                      s.text
                    )}
                  </p>
                </li>
              ))
            }
          </ol>

          <p class="mx-auto mt-24 flex max-w-4xl flex-wrap items-center justify-center gap-x-4 gap-y-2 rounded-3xl bg-dusk px-8 py-7 text-center text-sm text-linen/75 sm:rounded-full">
            <Icon name="ph:truck-light" class="size-6 shrink-0 text-gold" />
            <span>Delivery and setup fees may apply based on distance, location, access and event setup.</span>
            <a href={`tel:${TEL}`} class="font-display text-lg text-linen italic hover:text-gold-light">
              Contact us for a personalized quote.
            </a>
          </p>
        </div>
      </section>

      <!-- ═══ Contact ════════════════════════════════════════════════════ -->
      <section id="contact" class="grain relative isolate overflow-hidden bg-dusk pt-28 pb-40 text-center lg:pt-36 lg:pb-44">
        <Photo name="contact-bg" alt="" sizes="100vw" class="absolute inset-0 -z-10 size-full object-cover opacity-30" />
        <div
          class="absolute inset-0 -z-10 bg-[radial-gradient(55%_60%_at_50%_42%,rgb(23_17_11/0.55),rgb(23_17_11/0.92)_75%)]"
        ></div>

        <div class="relative mx-auto max-w-5xl px-5">
          <img src="/img/logo.webp" alt="Eventti Rentals & Decor" width="170" height="170" loading="lazy" class="mx-auto w-36 sm:w-44" />

          <p id="contact-script" class="gold-gradient mt-6 pb-3 font-script text-[clamp(2.6rem,8vw,5rem)] leading-[0.95]">
            Let's make it unforgettable
          </p>

          <a
            id="contact-phone"
            href={`tel:${TEL}`}
            class="display-caps mt-8 block text-[clamp(2.4rem,9vw,5.5rem)] text-linen hover:text-gold-light"
          >
            {PHONE}
          </a>
          <p class="mt-6 text-xs tracking-[0.4em] text-gold-light">Get a quote today</p>

          <div class="mt-14 flex flex-wrap items-center justify-center gap-x-10 gap-y-4 text-linen/75">
            <p class="flex items-center gap-2.5">
              <Icon name="ph:map-pin-light" class="size-5 text-gold" />
              {LOCATION}
            </p>
            <a href={TIKTOK} target="_blank" rel="noopener" class="flex items-center gap-2.5 hover:text-gold-light">
              <Icon name="ph:tiktok-logo-light" class="size-5 text-gold" />
              Find us on TikTok
            </a>
          </div>
        </div>

        <!-- Curva dorada del cierre del PDF -->
        <svg
          class="pointer-events-none absolute inset-x-0 bottom-0 h-28 w-full sm:h-36"
          viewBox="0 0 1200 140"
          preserveAspectRatio="none"
          aria-hidden="true"
        >
          <path id="curve-a" d="M0 132 Q600 24 1200 132" fill="none" stroke="#8a6a1f" stroke-width="3" />
          <path id="curve-b" d="M0 140 Q600 36 1200 140" fill="none" stroke="#e8cd8a" stroke-width="7" />
        </svg>
      </section>
    </main>

    <Footer />

    <script>
      import '../scripts/animations.js';
    </script>
  </body>
</html>
