---
import { Icon } from 'astro-icon/components';
import Photo from '../components/Photo.astro';
import '../styles/global.css';

const PHONE = '714 818 2320';
const TEL = '+17148182320';
// TODO: cambiar por el perfil real de TikTok.
const TIKTOK = 'https://www.tiktok.com/@eventti';

const occasions = [
  { icon: 'ph:cake', title: 'Birthdays', text: "Kids' parties, milestone birthdays and everything in between." },
  { icon: null, label: '15', title: 'Quinceañeras', text: 'A beautiful setup for her big day.' },
  { icon: 'ph:users-three', title: 'Corporate events', text: 'Clean, professional setups for teams and clients.' },
  { icon: 'ph:champagne', title: 'Family gatherings', text: 'Reunions, holidays and weekend get-togethers.' },
  { icon: 'ph:confetti', title: 'And more', text: 'Showers, graduations and more. Just ask.' },
];

const inventory = [
  { img: 'item-chair', title: 'Chairs', text: 'White folding chairs', w: 'w-24 sm:w-28' },
  { img: 'item-table', title: '6 ft rectangular tables', text: 'Standard banquet size', w: 'w-40 sm:w-52' },
  { img: 'item-linens', title: 'Tablecloths', text: 'Various colors', w: 'w-32 sm:w-40' },
  { img: 'item-popcorn', title: 'Popcorn machine', text: 'Classic cart, as pictured', w: 'w-20 sm:w-24' },
  { img: 'item-decor', title: 'Simple decor', text: 'Floral centerpieces & accents', w: 'w-28 sm:w-32' },
];

const rows = ['Guests', '6 ft tables', 'Chairs', 'Tablecloths', 'Simple decor', 'Popcorn machine'];

const packages = [
  { name: 'Basic', img: 'pkg-basic', price: 99, values: ['Up to 30', '4', '30', true, false, false] },
  { name: 'Celebration', img: 'pkg-celebration', price: 149, values: ['Up to 50', '6', '50', true, true, true] },
  { name: 'Complete', img: 'pkg-complete', price: 229, values: ['Up to 80', '10', '80', true, true, true] },
];

const steps = [
  { title: 'Get a quote', text: `Call ${PHONE} with your date, location and guest count.` },
  { title: 'Choose your package', text: 'Basic, Celebration or Complete, based on your guest list.' },
  { title: 'We deliver & set up', text: 'We bring everything to your event and set it up for you.' },
  { title: 'Celebrate', text: 'Enjoy the moment with your people.' },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Eventti Rentals &amp; Decor — Party rentals in Newport Beach, CA</title>
    <meta
      name="description"
      content="Tables, chairs, tablecloths, decor and a popcorn machine for birthdays, quinceañeras and family gatherings in Orange County. We deliver and set up. Packages from $99."
    />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" href="/img/monogram.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,500&family=Jost:wght@300;400;500&family=Pinyon+Script&display=swap"
      rel="stylesheet"
    />
    <link rel="preload" as="image" href="/img/hero-table.webp" type="image/webp" />

    <meta property="og:title" content="Eventti Rentals & Decor" />
    <meta property="og:description" content="Your event, our passion. Party rentals and setup in Orange County, CA." />
    <meta property="og:image" content="/img/hero-table.jpg" />
    <meta property="og:type" content="website" />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'LocalBusiness',
        name: 'Eventti Rentals & Decor',
        description: 'Event rental and decor company: tables, chairs, tablecloths, decor and popcorn machine.',
        telephone: TEL,
        areaServed: 'Orange County, CA',
        address: { '@type': 'PostalAddress', addressLocality: 'Newport Beach', addressRegion: 'CA', addressCountry: 'US' },
        priceRange: '$99–$229',
      })}
    />

    <noscript>
      <style>
        .will-reveal {
          opacity: 1 !important;
        }
      </style>
    </noscript>
  </head>

  <body class="bg-night">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[60] focus:rounded-full focus:bg-gold focus:px-5 focus:py-2 focus:text-sm focus:font-semibold focus:text-night"
    >
      Skip to content
    </a>

    <!-- Barra que entra cuando el hero sale de pantalla -->
    <header
      id="bar"
      class="fixed inset-x-0 top-0 z-50 hidden border-b border-gold/15 bg-night/90 backdrop-blur-md"
    >
      <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-5 py-3">
        <a href="#top" class="flex items-center gap-3">
          <img src="/img/monogram.png" alt="Eventti Rentals & Decor" width="36" height="36" class="size-9" />
          <span class="hidden text-sm tracking-[0.35em] text-cream/80 sm:block">EVENTTI</span>
        </a>
        <a
          href={`tel:${TEL}`}
          class="rounded-full border border-gold/60 px-6 py-2 text-xs tracking-[0.18em] text-gold-light uppercase hover:border-gold hover:bg-gold hover:text-night"
        >
          Call {PHONE}
        </a>
      </div>
    </header>

    <main id="main">
      <!-- 1 · Hero -->
      <section id="top" class="relative overflow-hidden bg-night">
        <div
          class="mx-auto grid max-w-6xl items-center gap-12 px-5 pt-20 pb-24 lg:grid-cols-[1.05fr_1fr] lg:gap-8 lg:pt-28 lg:pb-32"
        >
          <div>
            <img
              id="hero-logo"
              src="/img/logo.webp"
              alt="Eventti Rentals & Decor"
              width="200"
              height="200"
              fetchpriority="high"
              class="will-reveal w-40 sm:w-48"
            />

            <h1 class="mt-8">
              <span
                id="hero-line1"
                class="display-caps block overflow-clip pb-2 text-[clamp(2rem,6.5vw,3.9rem)] text-cream"
              >
                YOUR EVENT
              </span>
              <span
                id="hero-script"
                class="gold-gradient -mt-2 block pb-4 font-script text-[clamp(3.25rem,11.5vw,7rem)] leading-[0.82]"
              >
                Our Passion
              </span>
            </h1>

            <div id="hero-copy" class="will-reveal mt-6 max-w-sm">
              <p class="text-lg leading-relaxed text-cream/70">Tables, chairs, machines, decor &amp; more.</p>
              <p class="mt-2 font-display text-2xl text-gold-light italic">Rent. Decorate. Celebrate.</p>

              <div class="mt-10 flex flex-wrap items-center gap-7">
                <a
                  href={`tel:${TEL}`}
                  class="animated pulse infinite slower rounded-full bg-gold px-8 py-3.5 text-xs tracking-[0.2em] text-night uppercase hover:bg-gold-light"
                >
                  Call {PHONE}
                </a>
                <a
                  href="#packages"
                  class="border-b border-cream/25 pb-1 text-xs tracking-[0.2em] text-cream/70 uppercase hover:border-gold-light hover:text-gold-light"
                >
                  See packages
                </a>
              </div>

              <p class="mt-10 flex items-center gap-2.5 text-sm tracking-wide text-cream/55">
                <Icon name="ph:map-pin" class="size-4 text-gold" />
                Newport Beach, Orange County, CA
              </p>
            </div>
          </div>

          <!-- Foto circular con el doble anillo dorado del PDF -->
          <div class="relative mx-auto aspect-square w-full max-w-md lg:max-w-none">
            <svg id="hero-rings" viewBox="0 0 200 200" class="absolute inset-0 size-full -rotate-90" aria-hidden="true">
              <circle cx="100" cy="100" r="98" fill="none" stroke="#c9a227" stroke-width="0.8" />
              <circle cx="100" cy="100" r="92" fill="none" stroke="#f0d98c" stroke-width="2.5" />
            </svg>
            <div id="hero-photo" class="absolute inset-[6.5%] overflow-hidden rounded-full">
              <Photo
                name="hero-table"
                alt="Long banquet table set with white linens, burlap runner and floral centerpieces under string lights"
                width="900"
                height="1086"
                priority
                class="size-full scale-110 object-cover"
              />
            </div>
          </div>
        </div>
      </section>

      <!-- 2 · About -->
      <section class="bg-cream py-24 sm:py-32">
        <div class="mx-auto grid max-w-6xl items-center gap-14 px-5 lg:grid-cols-2 lg:gap-20">
          <div id="about-photo" class="relative mx-auto w-full max-w-sm lg:max-w-none">
            <div class="rounded-t-full rounded-b-2xl border border-gold/50 p-2">
              <div class="h-[26rem] overflow-hidden rounded-t-full rounded-b-xl sm:h-[32rem]">
                <Photo
                  name="about-arch"
                  alt="Banquet tables with floral centerpieces and white folding chairs in a backyard"
                  width="1100"
                  height="560"
                  class="size-full scale-[1.08] object-cover"
                />
              </div>
            </div>
          </div>

          <div id="about-copy">
            <span class="gold-line block h-px w-16"></span>
            <h2 class="display mt-7 text-[clamp(2.75rem,7vw,4.5rem)] text-ink">
              Good people.<br /><em class="italic-accent">Great events.</em>
            </h2>
            <p class="mt-7 max-w-prose text-lg leading-relaxed text-ink/75">
              Eventti is an event rental and decor company based in Newport Beach, Orange County. We bring
              the tables, chairs, tablecloths, decor and popcorn machine. Then we deliver and set it all up,
              so you can focus on your guests.
            </p>

            <dl class="mt-12 grid gap-8 border-t border-gold/30 pt-10 sm:grid-cols-3">
              <div>
                <dt class="font-display text-2xl text-gold-text italic">Rent</dt>
                <dd class="mt-3 text-sm leading-relaxed text-ink/70">
                  Tables, chairs, tablecloths and a classic popcorn machine.
                </dd>
              </div>
              <div>
                <dt class="font-display text-2xl text-gold-text italic">Decorate</dt>
                <dd class="mt-3 text-sm leading-relaxed text-ink/70">
                  Tablecloths in various colors and simple decor to set the mood.
                </dd>
              </div>
              <div>
                <dt class="font-display text-2xl text-gold-text italic">Celebrate</dt>
                <dd class="mt-3 text-sm leading-relaxed text-ink/70">We deliver and set up. You enjoy the moment.</dd>
              </div>
            </dl>
          </div>
        </div>
      </section>

      <!-- 3 · Occasions -->
      <section id="occasions" class="relative overflow-hidden bg-night py-24 sm:py-32">
        <svg
          class="pointer-events-none absolute -top-40 -right-32 size-[34rem] opacity-50"
          viewBox="0 0 400 400"
          aria-hidden="true"
        >
          <circle cx="200" cy="200" r="190" fill="none" stroke="#c9a227" stroke-width="0.6" />
          <circle cx="200" cy="200" r="170" fill="none" stroke="#c9a227" stroke-width="0.6" />
        </svg>

        <div class="relative mx-auto max-w-6xl px-5">
          <span class="gold-line block h-px w-16"></span>
          <h2 class="display mt-7 text-[clamp(2.5rem,6.5vw,4rem)] text-cream">
            Made for every
            <span class="gold-gradient font-script text-[1.35em] leading-[0.8]">celebration</span>
          </h2>
          <p class="mt-6 max-w-xl text-lg leading-relaxed text-cream/60">
            From a backyard birthday to a quinceañera, we set the table for your people.
          </p>

          <ul class="mt-16 grid grid-cols-2 gap-x-6 gap-y-12 sm:grid-cols-3 lg:grid-cols-5">
            {
              occasions.map((o) => (
                <li class="occasion text-center">
                  <div
                    class="relative mx-auto size-28 rounded-full bg-[radial-gradient(circle_at_50%_35%,#2a2114,#000_72%)] sm:size-32"
                  >
                    <svg viewBox="0 0 100 100" class="ring absolute inset-0 size-full -rotate-90" aria-hidden="true">
                      <circle cx="50" cy="50" r="48" fill="none" stroke="#c9a227" stroke-width="1.2" />
                    </svg>
                    <div class="mark absolute inset-0 grid place-items-center text-gold-light">
                      {o.icon ? (
                        <Icon name={o.icon} class="size-11" />
                      ) : (
                        <span class="lining font-display text-5xl">{o.label}</span>
                      )}
                    </div>
                  </div>
                  <h3 class="mt-6 font-display text-2xl text-cream">{o.title}</h3>
                  <p class="mx-auto mt-2 max-w-[18ch] text-sm leading-relaxed text-cream/55">{o.text}</p>
                </li>
              ))
            }
          </ul>

        </div>
      </section>

      <!-- 4 · Inventory -->
      <section id="inventory" class="bg-cream py-24 sm:py-32">
        <div class="mx-auto max-w-6xl px-5">
          <span class="gold-line block h-px w-16"></span>
          <h2 class="display mt-7 max-w-3xl text-[clamp(2.5rem,6.5vw,4.25rem)] text-ink">
            Everything you need to <em class="italic-accent">set the scene</em>
          </h2>
          <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink/65">
            The pieces behind every Eventti setup, delivered and set up at your event.
          </p>

          <ul class="mt-20 grid grid-cols-2 gap-x-6 gap-y-14 sm:grid-cols-3 lg:grid-cols-5">
            {
              inventory.map((item) => (
                <li class="item text-center">
                  <div class="flex h-40 items-end justify-center sm:h-48">
                    <Photo
                      name={item.img}
                      alt={item.title}
                      width="420"
                      height="420"
                      fallback="png"
                      class={`max-h-full ${item.w} object-contain`}
                    />
                  </div>
                  <div class="rule mt-6 h-px origin-left bg-gold/45" />
                  <h3 class="mt-5 font-display text-xl text-ink">{item.title}</h3>
                  <p class="mt-1.5 text-sm text-ink/60">{item.text}</p>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <!-- 5 · Popcorn -->
      <section class="overflow-hidden bg-night py-24 sm:py-32">
        <div class="mx-auto grid max-w-6xl items-center gap-14 px-5 lg:grid-cols-2 lg:gap-20">
          <div class="order-2 lg:order-1">
            <h2 id="popcorn-script" class="gold-gradient pb-4 font-script text-[clamp(3rem,9vw,5.5rem)] leading-[0.9]">
              Making events sweeter
            </h2>
            <div id="popcorn-copy" class="will-reveal">
              <p class="mt-8 max-w-md text-lg leading-relaxed text-cream/70">
                A classic popcorn cart that brings fresh popcorn and a little movie-night fun to any party.
                It works as a snack station and a centerpiece in one.
              </p>
              <p class="mt-10 inline-flex items-center gap-3 rounded-full border border-gold/50 px-6 py-3.5 text-sm text-cream/75">
                <Icon name="ph:check" class="size-4 shrink-0 text-gold" />
                Included in the <em class="font-display text-lg text-cream italic">Celebration</em> and
                <em class="font-display text-lg text-cream italic">Complete</em> packages
              </p>
            </div>
          </div>

          <div id="popcorn-photo" class="order-1 mx-auto w-full max-w-sm lg:order-2 lg:max-w-none">
            <div class="rounded-t-full rounded-b-2xl border border-gold/50 p-2">
              <div class="h-[30rem] overflow-hidden rounded-t-full rounded-b-xl sm:h-[36rem]">
                <Photo
                  name="popcorn-cart"
                  alt="Vintage popcorn cart serving fresh popcorn at an outdoor party"
                  width="900"
                  height="1200"
                  class="size-full scale-[1.08] object-cover"
                />
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- 6 · Packages -->
      <section id="packages" class="bg-cream py-24 sm:py-32">
        <div class="mx-auto max-w-6xl px-5">
          <div class="flex flex-wrap items-end justify-between gap-4">
            <div>
              <span class="gold-line block h-px w-16"></span>
              <h2 class="display mt-7 text-[clamp(2.5rem,6.5vw,4rem)] text-ink">
                Choose your <em class="italic-accent">package</em>
              </h2>
            </div>
            <p class="text-sm text-ink/70">Starting prices. Delivery and setup fees may apply.</p>
          </div>

          <!-- Comparativa en escritorio. Subgrid mantiene las filas alineadas
               con la columna de etiquetas sin alturas fijas. -->
          <div
            class="mt-14 hidden grid-cols-[13rem_repeat(3,1fr)] grid-rows-[auto_auto_repeat(6,auto)_auto] gap-x-5 lg:grid"
          >
            <div class="col-start-1 row-span-full grid grid-rows-subgrid">
              <span aria-hidden="true"></span>
              <span aria-hidden="true"></span>
              {rows.map((r) => <p class="flex items-center border-b border-ink/15 py-4 text-ink/80">{r}</p>)}
              <p class="flex items-center pt-6 text-ink/80">Starting at</p>
            </div>

            {
              packages.map((p) => (
                <div class="pkg row-span-full grid grid-rows-subgrid overflow-hidden rounded-2xl border border-gold/35 bg-white">
                  <h3 class="bg-night px-2 py-5 text-center text-xs tracking-[0.35em] text-cream">
                    {p.name.toUpperCase()}
                  </h3>
                  <Photo name={p.img} alt={`${p.name} package setup`} width="640" height="270" class="h-40 w-full object-cover" />
                  {p.values.map((v) => (
                    <div class="mx-4 flex items-center justify-center border-b border-ink/10 py-4">
                      {typeof v === 'boolean' ? (
                        v ? (
                          <span class="grid size-7 place-items-center rounded-full bg-gold/25 text-gold-text">
                            <Icon name="ph:check-bold" class="size-4" />
                          </span>
                        ) : (
                          <span class="text-ink/25">—</span>
                        )
                      ) : (
                        <span class="text-ink/85">{v}</span>
                      )}
                    </div>
                  ))}
                  <p class="relative grid place-items-center py-6">
                    <span class="brush absolute top-1/2 h-12 w-[62%] -translate-y-1/2 origin-left bg-gold/60" />
                    <span class="lining relative font-display text-5xl font-medium text-ink">
                      <span class="align-super text-2xl">$</span><span class="price" data-to={p.price}>{p.price}</span>
                    </span>
                  </p>
                </div>
              ))
            }
          </div>

          <!-- Móvil -->
          <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:hidden">
            {
              packages.map((p) => (
                <div class="pkg overflow-hidden rounded-2xl border border-gold/35 bg-white">
                  <h3 class="bg-night py-4 text-center text-xs tracking-[0.35em] text-cream">
                    {p.name.toUpperCase()}
                  </h3>
                  <Photo name={p.img} alt={`${p.name} package setup`} width="640" height="270" class="h-36 w-full object-cover" />
                  <ul class="divide-y divide-ink/10 px-5">
                    {rows.map((r, i) => (
                      <li class="flex items-center justify-between gap-4 py-3 text-sm">
                        <span class="text-ink/65">{r}</span>
                        {typeof p.values[i] === 'boolean' ? (
                          p.values[i] ? (
                            <Icon name="ph:check-bold" class="size-4 text-gold-text" />
                          ) : (
                            <span class="text-ink/25">—</span>
                          )
                        ) : (
                          <span class="font-semibold text-ink">{p.values[i]}</span>
                        )}
                      </li>
                    ))}
                  </ul>
                  <p class="relative grid place-items-center py-6">
                    <span class="brush absolute top-1/2 h-12 w-40 -translate-y-1/2 bg-gold/60" />
                    <span class="lining relative font-display text-5xl font-medium text-ink">
                      <span class="align-super text-2xl">$</span>{p.price}
                    </span>
                  </p>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <!-- 7 · Process -->
      <section id="process" class="bg-sand py-24 sm:py-32">
        <div class="mx-auto max-w-6xl px-5">
          <span class="gold-line block h-px w-16"></span>
          <h2 class="display mt-7 text-[clamp(2.5rem,6.5vw,4rem)] text-ink">
            We deliver <em class="italic-accent">&amp; set up</em>
          </h2>
          <p class="mt-6 text-lg leading-relaxed text-ink/65">Booking takes one call. Here's how it works.</p>

          <ol class="relative mt-20 grid gap-y-12 sm:grid-cols-2 lg:grid-cols-4">
            <span
              id="process-track"
              class="absolute top-8 right-[12.5%] left-[12.5%] hidden h-px origin-left bg-gold/60 lg:block"
              aria-hidden="true"
            ></span>

            {
              steps.map((s, i) => (
                <li class="step relative text-center">
                  <span class="dot lining relative z-10 mx-auto grid size-16 place-items-center rounded-full border border-gold bg-night font-display text-3xl text-gold-light">
                    {i + 1}
                  </span>
                  <h3 class="mt-6 font-display text-2xl text-ink">{s.title}</h3>
                  <p class="mx-auto mt-2.5 max-w-[26ch] text-sm leading-relaxed text-ink/65">
                    {i === 0 ? (
                      <>
                        Call <a href={`tel:${TEL}`} class="border-b border-ink/40 text-ink hover:border-gold">{PHONE}</a>{' '}
                        with your date, location and guest count.
                      </>
                    ) : (
                      s.text
                    )}
                  </p>
                </li>
              ))
            }
          </ol>

          <p class="mt-20 flex flex-wrap items-center gap-x-4 gap-y-2 rounded-2xl bg-night px-8 py-7 text-sm text-cream/70 sm:rounded-full">
            <Icon name="ph:truck" class="size-6 shrink-0 text-gold" />
            <span>Delivery and setup fees may apply based on distance, location, access and event setup.</span>
            <a href={`tel:${TEL}`} class="font-display text-lg text-cream italic hover:text-gold-light">
              Contact us for a personalized quote.
            </a>
          </p>
        </div>
      </section>

      <!-- 8 · Contact -->
      <section id="contact" class="relative overflow-hidden bg-night pt-24 pb-44 text-center sm:pt-32">
        <svg
          class="pointer-events-none absolute top-10 left-1/2 size-[42rem] -translate-x-1/2 opacity-40"
          viewBox="0 0 400 400"
          aria-hidden="true"
        >
          <circle cx="200" cy="200" r="198" fill="none" stroke="#c9a227" stroke-width="0.5" />
        </svg>

        <div class="relative mx-auto max-w-3xl px-5">
          <img src="/img/logo.webp" alt="Eventti Rentals & Decor" width="170" height="170" loading="lazy" class="mx-auto w-36 sm:w-44" />

          <p id="contact-script" class="gold-gradient mt-4 pb-3 font-script text-[clamp(2.25rem,8vw,4.5rem)] leading-[0.95]">
            Let's make it unforgettable
          </p>

          <a
            id="contact-phone"
            href={`tel:${TEL}`}
            class="display-caps mt-6 block text-[clamp(2.25rem,9vw,5.25rem)] text-cream hover:text-gold-light"
          >
            {PHONE}
          </a>

          <p class="eyebrow mt-7 text-gold-light">Get a quote today</p>

          <div class="mt-14 flex flex-wrap items-center justify-center gap-x-10 gap-y-4 text-cream/70">
            <p class="flex items-center gap-2">
              <Icon name="ph:map-pin" class="size-5 text-gold" />
              Newport Beach, Orange County, CA
            </p>
