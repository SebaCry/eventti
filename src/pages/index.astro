---
import { Icon } from 'astro-icon/components';
import '../styles/global.css';

const CONTACT = {
  phone: '+1 (323) 592-2238',
  whatsapp: '13235922238',
  email: 'hello@eventti.com',
  area: 'California',
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Eventti — Rentals &amp; Decor | Coming Soon</title>
    <meta
      name="description"
      content="Eventti Rentals & Decor — event furniture, decor and styling in California. Our new site is on the way. Message us on WhatsApp in the meantime."
    />
    <meta name="theme-color" content="#0b0b0c" />
    <link rel="icon" href="/img/monograma.jpg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300&family=Jost:wght@300;400;500&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="antialiased">
    <main class="relative flex min-h-svh flex-col items-center justify-center overflow-hidden bg-ink px-6 py-16 text-center">
      <img
        src="/img/hero.jpg"
        alt=""
        aria-hidden="true"
        class="absolute inset-0 size-full scale-105 object-cover opacity-35"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-ink via-ink/60 to-ink"></div>

      <div class="relative z-10">
        <img
          src="/img/logo.jpg"
          alt="Eventti Rentals & Decor"
          width="320"
          height="320"
          class="mx-auto w-56 sm:w-72"
          style="mask-image: radial-gradient(circle, #000 60%, transparent 76%); -webkit-mask-image: radial-gradient(circle, #000 60%, transparent 76%);"
        />

        <p class="mt-4 text-[11px] uppercase tracking-[0.42em] text-gold-light/80">Rentals &amp; Decor</p>

        <h1 class="mt-6 font-display text-4xl font-light leading-[1.15] text-cream sm:text-6xl">
          Something beautiful<br />
          <em class="gold-text not-italic">is on the way</em>
        </h1>

        <div class="gold-rule mx-auto mt-8 h-px w-40"></div>

        <p class="mx-auto mt-8 max-w-lg text-base font-light leading-relaxed text-cream/70">
          We're putting the finishing touches on our new site. In the meantime we're already
          styling weddings, quinceañeras and celebrations across {CONTACT.area} — send us a
          message and we'll take it from there.
        </p>

        <a
          href={`https://wa.me/${CONTACT.whatsapp}`}
          class="mt-10 inline-flex items-center gap-2 rounded-full bg-gradient-to-r from-[#9a7418] via-gold-light to-[#9a7418] px-8 py-3.5 text-[12px] uppercase tracking-[0.22em] text-ink transition hover:brightness-110"
        >
          <Icon name="ph:whatsapp-logo" class="size-4" />
          Message us on WhatsApp
        </a>

        <ul class="mt-10 flex flex-wrap items-center justify-center gap-x-8 gap-y-3 text-sm text-cream/60">
          <li>
            <a href={`tel:+${CONTACT.whatsapp}`} class="flex items-center gap-2 transition hover:text-gold-light">
              <Icon name="ph:phone" class="size-4 text-gold" />{CONTACT.phone}
            </a>
          </li>
          <li>
            <a href={`mailto:${CONTACT.email}`} class="flex items-center gap-2 transition hover:text-gold-light">
              <Icon name="ph:envelope-simple" class="size-4 text-gold" />{CONTACT.email}
            </a>
          </li>
        </ul>
      </div>

      <footer class="absolute inset-x-0 bottom-6 z-10 text-[11px] uppercase tracking-[0.3em] text-cream/30">
        Eventti Rentals &amp; Decor · {new Date().getFullYear()}
      </footer>
    </main>
  </body>
</html>
