---
// El remate del logo (filete, estrella de cuatro puntas, filete) como divisor de sección.
interface Props {
  class?: string;
  align?: 'start' | 'center';
}
const { class: className = '', align = 'start' } = Astro.props;
---

<svg
  class:list={['h-3 w-28', align === 'center' && 'mx-auto', className]}
  viewBox="0 0 112 12"
  fill="none"
  aria-hidden="true"
>
  {align === 'center' && <path d="M0 6h46" stroke="currentColor" stroke-width="0.8" />}
  <path
    d={align === 'center' ? 'M56 0c.6 3.6 2.4 5.4 6 6-3.6.6-5.4 2.4-6 6-.6-3.6-2.4-5.4-6-6 3.6-.6 5.4-2.4 6-6Z' : 'M6 0c.6 3.6 2.4 5.4 6 6-3.6.6-5.4 2.4-6 6-.6-3.6-2.4-5.4-6-6 3.6-.6 5.4-2.4 6-6Z'}
    fill="currentColor"
  />
  <path d={align === 'center' ? 'M66 6h46' : 'M16 6h96'} stroke="currentColor" stroke-width="0.8" />
</svg>
